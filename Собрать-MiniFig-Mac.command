#!/bin/bash
# Двойной клик по этому файлу собирает приложение MiniFig для Mac.
# Нужен установленный Node.js (один раз). Остальное произойдёт автоматически.
cd "$(dirname "$0")"
clear
echo "==================================================="
echo "   Сборка MiniFig для Mac"
echo "==================================================="
echo ""

if ! command -v node >/dev/null 2>&1; then
  echo "❌ Не найден Node.js — он нужен для сборки (ставится один раз)."
  echo "   Сейчас откроется сайт. Скачайте кнопку LTS, установите,"
  echo "   затем снова дважды кликните по этому файлу."
  open "https://nodejs.org/en/download" 2>/dev/null
  echo ""
  echo "Нажмите Enter для выхода."
  read
  exit 1
fi

echo "✓ Node.js: $(node -v)"
echo ""
echo "→ Устанавливаю зависимости (первый раз ~1–3 минуты, скачивает Electron)…"
npm install || { echo ""; echo "❌ Не удалось установить зависимости. Проверьте интернет и повторите."; echo "Нажмите Enter."; read; exit 1; }

echo ""
echo "→ Собираю приложение…"
npm run dist:mac || { echo ""; echo "❌ Ошибка сборки. Напишите мне, что в логе выше."; echo "Нажмите Enter."; read; exit 1; }

echo ""
echo "==================================================="
echo "   ✅ Готово!"
echo "==================================================="
echo "В папке dist лежит MiniFig-...dmg — откройте и перетащите MiniFig в «Программы»."
echo "При первом запуске: правый клик по MiniFig → «Открыть» (приложение без подписи Apple)."
open dist 2>/dev/null
echo ""
echo "Нажмите Enter для выхода."
read
